{
  "expo": {
    "name": "QuizLift",
    "slug": "quizlift",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "quizlift",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.example.quizlift" },
    "android": { "package": "com.example.quizlift" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
